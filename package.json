{
  "name": "pngjs-nextgen",
  "version": "8.0.0-alpha.0",
  "description": "Modern continuation of pngjs",
  "author": "chickenpoo",
  "contributors": [
    "Alexandre Paré",
    "Gaurav Mali",
    "Gusts Kaksis",
    "Kuba Niegowski",
    "Luke Page",
    "Pietajan De Potter",
    "Steven Sojka",
    "liangzeng",
    "Michael Vogt",
    "Xin-Xin Wang",
    "toriningen",
    "Eugene Kulabuhov"
  ],
  "homepage": "https://github.com/chickenpoo351/pngjs-nextgen",
  "keywords": [
    "PNG",
    "decoder",
    "encoder",
    "js-png",
    "node-png",
    "parser",
    "png",
    "png-js",
    "png-parse",
    "pngjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./lib/png.js",
  "directories": {
    "lib": "lib",
    "example": "examples",
    "test": "test"
  },
  "files": [
    "browser.js",
    "lib/"
  ],
  "scripts": {
    "build": "pnpm prepublish",
    "prepublish": "pnpm browserify",
    "browserify": "browserify lib/png.js --standalone png > browser.js",
    "coverage": "vitest run --coverage",
    "test": "pnpm lint && pnpm format:check && vitest run",
    "lint": "oxlint .",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chickenpoo351/pngjs-nextgen.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chickenpoo351/pngjs-nextgen/issues"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "browserify": "17.0.0",
    "dprint": "^0.55.2",
    "oxlint": "^1.76.0",
    "puppeteer": "25.4.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.7.1"
}
